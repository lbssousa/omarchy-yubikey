<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Omarchy YubiKey</vendor>
  <vendor_url>https://github.com/marselnenaj/omarchy-yubikey</vendor_url>
  <action id="org.omarchy-yubikey.key-mapping">
    <description>Add or remove your own security-key registrations</description>
    <message>Authentication is required to change the security keys registered for your account</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/omarchy-yubikey/key-mapping-helper</annotate>
  </action>
</policyconfig>
